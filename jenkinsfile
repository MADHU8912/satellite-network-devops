pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Files') {
            steps {
                bat 'dir'
            }
        }

        stage('Build Report') {
            steps {
                bat 'echo Build successful > build-report.txt'
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'build-report.txt', fingerprint: true
        }
        failure {
            bat 'echo Build failed > build-report.txt'
            archiveArtifacts artifacts: 'build-report.txt', fingerprint: true
        }
    }
}